{
  "name": "@artifice-ia/fleet-bus",
  "version": "0.1.0",
  "description": "Envelope schema, NATS client, and validation for the Artifice fleet-bus. Consumed by artifice-ia/claude-discord (TypeScript) and artifice-ia/codex-container (Python, via vendored JSON-Schema).",
  "type": "module",
  "main": "./src/fleet-bus.ts",
  "types": "./src/fleet-bus.ts",
  "exports": {
    ".": "./src/fleet-bus.ts",
    "./schema/envelope.v1": "./schema/envelope.v1.schema.json"
  },
  "files": [
    "src/fleet-bus.ts",
    "schema/envelope.v1.schema.json",
    "SPEC.md"
  ],
  "scripts": {
    "test": "bun test src/fleet-bus.test.ts",
    "test:gates": "bun test/gates/test-suite.ts",
    "schema:hash": "sha256sum schema/envelope.v1.schema.json"
  },
  "dependencies": {
    "nats": "^2.29.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/artifice-ia/fleet-bus"
  },
  "license": "Apache-2.0"
}
